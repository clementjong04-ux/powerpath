# Copy to .env.local and fill in your own values to run PowerPath locally.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server-only

# Anthropic — powers the Analyst & Memo agents (AI explanation / drafting).
# Without it the app still runs: explanations fall back to a deterministic template.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY
